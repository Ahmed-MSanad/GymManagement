@model AnalyticsViewModel
@{
    ViewData["Title"] = "Home Page";
}

<!-- ═══════════════════════════════════════════
     HERO
════════════════════════════════════════════ -->
<section class="hero-grid" style="display:grid; grid-template-columns:1fr 1fr; position:relative; overflow:hidden;">

    <!-- LEFT -->
    <div class="hero-left" style="padding:clamp(100px,12vw,160px) clamp(30px,5vw,80px) 80px; display:flex; flex-direction:column; justify-content:center; position:relative; z-index:2;">

        <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
            <span style="width:40px; height:2px; background:#FF3D00; display:block; flex-shrink:0;"></span>
            <span style="font-size:11px; letter-spacing:0.25em; text-transform:uppercase; color:#FF3D00; font-weight:500;">Elite Performance Training</span>
        </div>

        <h1 style="font-family:'Bebas Neue',sans-serif; font-size:clamp(64px,9vw,80px); line-height:0.9; margin-bottom:32px; color:#F5F5F0; letter-spacing:0.02em;">
            Your Limits<br>Are Only<br>
            <em style="font-family:'Playfair Display',serif; font-style:italic; color:#FF3D00; font-size:0.75em;">In Your</em><br>
            Mind
        </h1>

        <p style="font-size:15px; line-height:1.8; color:#B0B0B0; max-width:400px; margin-bottom:48px;">
            Elevate your mindset, exceed your limits, and sculpt a body that reflects strength, control, and commitment.
        </p>

        <div style="display:flex; align-items:center; gap:24px;">
            <button class="btn-fire" style="display:inline-flex; align-items:center; gap:10px; padding:16px 36px; background:#FF3D00; color:#fff; font-family:'DM Sans',sans-serif; font-weight:500; font-size:13px; letter-spacing:0.15em; text-transform:uppercase; border:none; cursor:pointer; clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px)); transition:background 0.25s ease,transform 0.25s ease; position:relative; overflow:hidden;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                Get Started
            </button>
            <button class="btn-ghost" style="display:inline-flex; align-items:center; gap:8px; color:#F5F5F0; font-size:13px; letter-spacing:0.1em; text-transform:uppercase; border:none; background:none; cursor:pointer; padding:0; transition:color 0.2s;">
                <span class="arr-circle" style="width:32px; height:32px; border:1px solid rgba(255,255,255,0.3); border-radius:50%; display:flex; align-items:center; justify-content:center;">
                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                </span>
                Explore More
            </button>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="hero-right" style="position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden;">
        <div aria-hidden="true" style="font-family:'Bebas Neue',sans-serif; font-size:clamp(180px,25vw,340px); line-height:0.85; color:transparent; -webkit-text-stroke:1px rgba(255,61,0,0.25); position:absolute; right:-0.05em; bottom:-0.05em; z-index:0; pointer-events:none; user-select:none;">1</div>
        <img src="~/images/main-image.png" alt="Elite Athlete" style="object-fit:cover; object-position:top center; filter:grayscale(30%) contrast(1.1); transition:filter 0.6s ease; display:block;">
    </div>
</section>


<!-- ═══════════════════════════════════════════
     STATS STRIP
════════════════════════════════════════════ -->
<div style="background:#1A1A1A; border-top:1px solid rgba(255,61,0,0.2); border-bottom:1px solid rgba(255,61,0,0.2); padding:40px 0;">
    <div class="stats-grid" style="display:grid; grid-template-columns:repeat(6,1fr); max-width:1400px; margin:0 auto; padding:0 clamp(20px,5vw,80px);">

        <div style="text-align:center; padding:20px;">
            <span style="font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,4vw,56px); color:#FF3D00; line-height:1; display:block;">@Model.TotalMembers</span>
            <span style="font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#B0B0B0; margin-top:6px; display:block;">Total Members</span>
        </div>
        <div style="text-align:center; padding:20px; border-left:1px solid rgba(255,255,255,0.08);">
            <span style="font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,4vw,56px); color:#FF3D00; line-height:1; display:block;">@Model.ActiveMembers</span>
            <span style="font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#B0B0B0; margin-top:6px; display:block;">Active Members</span>
        </div>
        <div style="text-align:center; padding:20px; border-left:1px solid rgba(255,255,255,0.08);">
            <span style="font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,4vw,56px); color:#FF3D00; line-height:1; display:block;">@Model.TotalTrainers</span>
            <span style="font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#B0B0B0; margin-top:6px; display:block;">Trainers</span>
        </div>
        <div style="text-align:center; padding:20px; border-left:1px solid rgba(255,255,255,0.08);">
            <span style="font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,4vw,56px); color:#FF3D00; line-height:1; display:block;">@Model.UpcomingSessions</span>
            <span style="font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#B0B0B0; margin-top:6px; display:block;">Upcoming Sessions</span>
        </div>
        <div style="text-align:center; padding:20px; border-left:1px solid rgba(255,255,255,0.08);">
            <span style="font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,4vw,56px); color:#FF3D00; line-height:1; display:block;">@Model.OngoingSessions</span>
            <span style="font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#B0B0B0; margin-top:6px; display:block;">Ongoing Sessions</span>
        </div>
        <div style="text-align:center; padding:20px; border-left:1px solid rgba(255,255,255,0.08);">
            <span style="font-family:'Bebas Neue',sans-serif; font-size:clamp(36px,4vw,56px); color:#FF3D00; line-height:1; display:block;">@Model.CompletedSessions</span>
            <span style="font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#B0B0B0; margin-top:6px; display:block;">Completed Sessions</span>
        </div>

    </div>
</div>

<!-- ═══════════════════════════════════════════
     TICKER
════════════════════════════════════════════ -->
<div aria-hidden="true" style="background:#FF3D00; padding:14px 0; overflow:hidden;">
    <div class="ticker-track" style="display:flex; width:max-content; white-space:nowrap;">
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Outdoor Trainers <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Online Classes <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Personal Training <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Live Sessions <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Certified Coaches <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Elite Programs <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <!-- duplicate for seamless loop -->
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Outdoor Trainers <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Online Classes <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Personal Training <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Live Sessions <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Certified Coaches <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
        <span style="font-family:'Bebas Neue',sans-serif; font-size:15px; letter-spacing:0.15em; padding:0 40px; color:#fff; display:inline-flex; align-items:center; gap:16px;">Elite Programs <span style="width:6px;height:6px;background:rgba(255,255,255,0.5);border-radius:50%;display:inline-block;"></span></span>
    </div>
</div>

<!-- ═══════════════════════════════════════════
     ABOUT
════════════════════════════════════════════ -->
<section>
    <div class="about-grid" style="padding:clamp(80px,10vw,140px) clamp(20px,5vw,80px); max-width:1400px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:clamp(40px,6vw,100px); align-items:center;">

        <!-- images -->
        <div class="about-imgs" style="position:relative; height:clamp(400px,55vw,680px);">
            <div style="position:absolute; width:70%; height:80%; top:0; left:0; overflow:hidden; border-radius:4px;">
                <img src="~/images/about-1.png" alt="Training session" style="width:100%; height:100%; object-fit:cover; display:block; filter:grayscale(20%);">
            </div>
            <div style="position:absolute; width:48%; height:52%; bottom:0; right:0; overflow:hidden; border-radius:4px; border:3px solid #FF3D00; z-index:2;">
                <img src="~/images/about-2.png" alt="Athlete" style="width:100%; height:100%; object-fit:cover; display:block;">
            </div>
            <div class="about-badge" style="position:absolute; top:50%; left:55%; width:110px; height:110px; background:#FF3D00; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:3; box-shadow:0 0 0 8px #0F0F0F,0 0 0 16px rgba(255,61,0,0.2);">
                <span style="font-family:'Bebas Neue',sans-serif; font-size:28px; line-height:1; color:#fff; display:block;">10+</span>
                <span style="font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.8);">Years</span>
            </div>
        </div>

        <!-- content -->
        <div>
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
                <span style="font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#FF3D00; font-weight:500;">About Us</span>
                <span style="width:30px; height:1px; background:#FF3D00; display:block;"></span>
            </div>

            <h2 style="font-family:'Bebas Neue',sans-serif; font-size:clamp(40px,5vw,72px); line-height:0.95; margin-bottom:24px; color:#F5F5F0; letter-spacing:0.02em;">
                Empowering You<br>to Achieve Your<br>
                <em style="font-family:'Playfair Display',serif; font-style:italic; color:#FF3D00;">Fitness</em> Goals
            </h2>

            <p style="color:#B0B0B0; font-size:15px; line-height:1.8; margin-bottom:40px;">
                Fitness is more than a workout — it's a lifestyle. With top-of-the-line facilities,
                certified trainers, and a supportive community, we're here to inspire and guide you every step of the way.
            </p>

            <!-- feature cards -->
            <div class="feats-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:2px; margin-bottom:40px;">

                <div class="feat-card" style="background:#1A1A1A; padding:24px; position:relative; overflow:hidden; transition:background 0.3s;">
                    <div style="width:36px; height:36px; background:#FF3D00; display:flex; align-items:center; justify-content:center; margin-bottom:16px; clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    </div>
                    <div style="font-family:'Bebas Neue',sans-serif; font-size:18px; letter-spacing:0.05em; margin-bottom:6px; color:#F5F5F0;">Personal Trainer</div>
                    <div style="font-size:12px; color:#B0B0B0; line-height:1.7;">Achieve your goals with certified expert guidance.</div>
                    <div class="feat-line" style="position:absolute; bottom:0; left:0; width:0; height:2px; background:#FF3D00;"></div>
                </div>

                <div class="feat-card" style="background:#1A1A1A; padding:24px; position:relative; overflow:hidden; transition:background 0.3s;">
                    <div style="width:36px; height:36px; background:#FF3D00; display:flex; align-items:center; justify-content:center; margin-bottom:16px; clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    </div>
                    <div style="font-family:'Bebas Neue',sans-serif; font-size:18px; letter-spacing:0.05em; margin-bottom:6px; color:#F5F5F0;">Live Classes</div>
                    <div style="font-size:12px; color:#B0B0B0; line-height:1.7;">Real-time group sessions that keep you motivated.</div>
                    <div class="feat-line" style="position:absolute; bottom:0; left:0; width:0; height:2px; background:#FF3D00;"></div>
                </div>

                <div class="feat-card" style="background:#1A1A1A; padding:24px; position:relative; overflow:hidden; transition:background 0.3s;">
                    <div style="width:36px; height:36px; background:#FF3D00; display:flex; align-items:center; justify-content:center; margin-bottom:16px; clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    </div>
                    <div style="font-family:'Bebas Neue',sans-serif; font-size:18px; letter-spacing:0.05em; margin-bottom:6px; color:#F5F5F0;">Flexible Timing</div>
                    <div style="font-size:12px; color:#B0B0B0; line-height:1.7;">Train on your schedule, not ours.</div>
                    <div class="feat-line" style="position:absolute; bottom:0; left:0; width:0; height:2px; background:#FF3D00;"></div>
                </div>

                <div class="feat-card" style="background:#1A1A1A; padding:24px; position:relative; overflow:hidden; transition:background 0.3s;">
                    <div style="width:36px; height:36px; background:#FF3D00; display:flex; align-items:center; justify-content:center; margin-bottom:16px; clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                    </div>
                    <div style="font-family:'Bebas Neue',sans-serif; font-size:18px; letter-spacing:0.05em; margin-bottom:6px; color:#F5F5F0;">Track Progress</div>
                    <div style="font-size:12px; color:#B0B0B0; line-height:1.7;">Data-driven insights to measure your gains.</div>
                    <div class="feat-line" style="position:absolute; bottom:0; left:0; width:0; height:2px; background:#FF3D00;"></div>
                </div>

            </div>

            <button class="btn-fire" style="display:inline-flex; align-items:center; gap:10px; padding:16px 36px; background:#FF3D00; color:#fff; font-family:'DM Sans',sans-serif; font-weight:500; font-size:13px; letter-spacing:0.15em; text-transform:uppercase; border:none; cursor:pointer; clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px)); transition:background 0.25s ease,transform 0.25s ease;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                Start Your Journey
            </button>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     WORKOUTS
════════════════════════════════════════════ -->
<section style="background:#1A1A1A; padding:clamp(80px,10vw,140px) clamp(20px,5vw,80px); position:relative; overflow:hidden;">

    <div aria-hidden="true" style="font-family:'Bebas Neue',sans-serif; font-size:30vw; position:absolute; right:-2%; top:50%; transform:translateY(-50%); color:transparent; -webkit-text-stroke:1px rgba(255,61,0,0.06); pointer-events:none; line-height:1; user-select:none;">TRAIN</div>

    <!-- header -->
    <div class="w-header" style="max-width:1400px; margin:0 auto 60px; display:flex; justify-content:space-between; align-items:flex-end; position:relative; z-index:1;">
        <div>
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
                <span style="font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#FF3D00; font-weight:500;">Programs</span>
                <span style="width:30px; height:1px; background:#FF3D00; display:block;"></span>
            </div>
            <h2 style="font-family:'Bebas Neue',sans-serif; font-size:clamp(40px,5vw,72px); line-height:0.95; color:#F5F5F0; letter-spacing:0.02em;">
                Transform With<br>Our Dynamic<br>
                <em style="font-family:'Playfair Display',serif; font-style:italic; color:#FF3D00;">Workouts</em>
            </h2>
        </div>
        <button class="btn-ghost" style="display:inline-flex; align-items:center; gap:8px; color:#F5F5F0; font-size:13px; letter-spacing:0.1em; text-transform:uppercase; border:none; background:none; cursor:pointer; padding-bottom:8px; transition:color 0.2s; align-self:flex-end;">
            <span class="arr-circle" style="width:32px; height:32px; border:1px solid rgba(255,255,255,0.3); border-radius:50%; display:flex; align-items:center; justify-content:center;">
                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </span>
            View All Programs
        </button>
    </div>

    <!-- cards -->
    <div class="w-cards" style="max-width:1400px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:16px; position:relative; z-index:1;">

        <div class="w-card" style="position:relative; overflow:hidden; aspect-ratio:3/4; background:#2A2A2A; cursor:pointer;">
            <img src="~/images/workout_1.png" alt="Group Workout" style="width:100%; height:100%; object-fit:cover; display:block; filter:grayscale(40%) brightness(0.8);">
            <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,0.9) 0%,transparent 60%); display:flex; flex-direction:column; justify-content:flex-end; padding:32px 28px;">
                <div class="w-num" style="font-family:'Bebas Neue',sans-serif; font-size:72px; line-height:1; color:transparent; -webkit-text-stroke:1px rgba(255,255,255,0.15); position:absolute; top:20px; right:20px; transition:-webkit-text-stroke 0.3s;">01</div>
                <p style="font-size:10px; letter-spacing:0.25em; text-transform:uppercase; color:#FF3D00; margin-bottom:8px;">Community</p>
                <h3 style="font-family:'Bebas Neue',sans-serif; font-size:32px; letter-spacing:0.05em; line-height:1; margin-bottom:16px; color:#F5F5F0;">Group Workout</h3>
                <a href="#" class="w-link" style="display:inline-flex; align-items:center; gap:8px; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.5); text-decoration:none; transition:color 0.2s;">
                    <span class="w-line" style="width:24px; height:1px; background:currentColor; transition:width 0.3s ease; display:block;"></span>Explore
                </a>
            </div>
        </div>

        <div class="w-card" style="position:relative; overflow:hidden; aspect-ratio:3/4; background:#2A2A2A; cursor:pointer;">
            <img src="~/images/workout_2.png" alt="Strength Training" style="width:100%; height:100%; object-fit:cover; display:block; filter:grayscale(40%) brightness(0.8);">
